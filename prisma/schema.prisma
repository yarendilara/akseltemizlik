generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// *
/// * USERS & PROFILES
model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  role            UserRole         @default(CUSTOMER)
  createdAt       DateTime         @default(now())
  auditLogs       AuditLog[]
  cleanerProfile  CleanerProfile?
  customerProfile CustomerProfile?

  @@index([email])
}

model CustomerProfile {
  id     String @id @default(uuid())
  userId String @unique
  name   String
  phone  String
  user   User   @relation(fields: [userId], references: [id])
}

model CleanerProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  tcknEncrypted      String              @unique
  districts          String
  services           String
  status             String              @default("ACTIVE")
  availabilityConfig String
  bookingAssignments BookingAssignment[]
  user               User                @relation(fields: [userId], references: [id])

  @@index([status])
}

model CleanerApplication {
  id            String            @id @default(uuid())
  fullName      String
  tcknEncrypted String            @unique
  phone         String
  email         String            @unique
  districts     String
  serviceIds    String
  documentKey   String
  status        ApplicationStatus @default(SUBMITTED)
  adminNotes    String?
  createdAt     DateTime          @default(now())

  @@index([status])
  @@index([email])
}

/// *
/// * BOOKINGS & SCHEDULING
model Booking {
  id            String              @id @default(uuid())
  status        BookingStatus       @default(SUBMITTED)
  customerId    String?
  serviceId     String
  districtId    String
  address       String
  notes         String?
  startAt       DateTime
  endAt         DateTime
  isOverride    Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  customerEmail String
  customerName  String
  customerPhone String
  assignments   BookingAssignment[]

  @@index([status])
  @@index([startAt, endAt])
  @@index([districtId])
}

model BookingAssignment {
  id         String         @id @default(uuid())
  bookingId  String
  cleanerId  String
  assignedAt DateTime       @default(now())
  booking    Booking        @relation(fields: [bookingId], references: [id])
  cleaner    CleanerProfile @relation(fields: [cleanerId], references: [id])

  @@unique([bookingId, cleanerId])
  @@index([cleanerId])
}

model AdminCalendarBlock {
  id         String   @id @default(uuid())
  date       DateTime @db.Date
  startAt    DateTime
  endAt      DateTime
  reason     String
  districtId String?

  @@index([date])
  @@index([startAt, endAt])
}

/// *
/// * SECURITY & LOGS
model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  action         String
  targetResource String
  targetId       String
  payload        String
  timestamp      DateTime @default(now())
  user           User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetId])
  @@index([timestamp])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model JobApplication {
  id         String   @id @default(uuid())
  fullName   String
  residence  String
  phone      String
  email      String?
  birthDate  DateTime
  experience String
  status     String   @default("SUBMITTED")
  createdAt  DateTime @default(now())

  @@index([status])
}

model SiteSetting {
  key   String @id
  value String
}

enum UserRole {
  ADMIN
  CLEANER
  CUSTOMER
}

enum BookingStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  AWAITING_ASSIGNMENT
  ASSIGNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
  RESCHEDULED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  DOCUMENT_APPROVED
  INTERVIEW_PENDING
  APPROVED
  REJECTED
}
